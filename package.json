{
  "name": "@reso-standards/reso-uli",
  "version": "0.1.0",
  "type": "module",
  "description": "RCP-54 ULI Resolution Protocol reference node: one SDK, two adapters.",
  "main": "./dist/sdk/index.js",
  "types": "./dist/sdk/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/sdk/index.d.ts",
      "import": "./dist/sdk/index.js"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "serve": "npm run build && node dist/bin/serve.js",
    "ingest:csv": "npm run build && node dist/bin/ingest-csv.js",
    "ingest:webapi": "npm run build && node dist/bin/ingest-webapi.js"
  },
  "dependencies": {
    "@reso-standards/reso-client": "0.2.2",
    "express": "5.3.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.7.0",
    "vitest": "^4.0.0"
  }
}
